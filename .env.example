# Copy file này thành .env rồi điền giá trị thật
DEEPSEEK_API_KEY=sk-your-deepseek-key
VBEE_TOKEN=your-vbee-jwt-token
VBEE_APP_ID=your-vbee-app-id
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-key
JWT_SECRET=change-this-to-random-string-64-chars
DOMAIN=yourdomain.com

# GitHub auto-deploy webhook
GITHUB_WEBHOOK_SECRET=long-random-string-matching-github-settings
DEPLOY_BRANCH=main
# Lệnh restart app sau khi pull (tùy môi trường — để trống nếu chỉ đổi static/CSS)
# aaPanel Python Manager ví dụ: DEPLOY_RESTART_CMD=bash /www/server/panel/pyproject_evn/restart_gpt.sh
DEPLOY_RESTART_CMD=

# ===== Dropbox backup (đẩy data/ lên Dropbox + giải phóng ổ đĩa) =====
# Cách khuyến nghị (token dài hạn — không hết hạn). Xem docs/DROPBOX_BACKUP.md.
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Hoặc dùng access token ngắn hạn (hết hạn sau ~4h, chỉ để test):
DROPBOX_ACCESS_TOKEN=
# Thư mục lưu trên Dropbox (mặc định /gpt-sbay-backups)
DROPBOX_BACKUP_DIR=/gpt-sbay-backups
# Số bản backup DB giữ lại trên Dropbox
BACKUP_KEEP=14
# Giữ file upload trong ổ đĩa server bao nhiêu ngày trước khi đẩy lên Dropbox + xoá local (0 = xoá ngay sau backup)
UPLOAD_RETENTION_DAYS=7
