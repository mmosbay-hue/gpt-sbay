# Copy file này thành .env rồi điền giá trị thật
# Lệnh: cp .env.example .env

# ===== DeepSeek (BẮT BUỘC) =====
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ===== Server =====
PORT=8080
DOMAIN=localhost:8080

# ===== Auth =====
JWT_SECRET=change-this-to-random-string-64-chars

# ===== Stripe (tùy chọn) =====
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ===== Vbee TTS (tùy chọn — để trống sẽ fallback Google TTS) =====
VBEE_TOKEN=
VBEE_APP_ID=

# ===== Admin seed (dùng khi chạy `python -m backend.db.seed`) =====
ADMIN_EMAIL=admin@gptweb.com
ADMIN_PASSWORD=
